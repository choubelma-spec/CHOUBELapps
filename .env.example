# Base de données PostgreSQL (Neon, Supabase, ou autre)
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Chaîne aléatoire longue utilisée pour signer les sessions.
# Générer par exemple avec : openssl rand -base64 32
AUTH_SECRET="remplacer-par-une-longue-chaine-aleatoire"

# Compte administrateur créé par le script de seed (prisma/seed.js).
# À changer immédiatement après la première connexion.
ADMIN_NAME="Administrateur Choubel"
ADMIN_EMAIL="admin@cabinetchoubel.com"
ADMIN_PASSWORD="ChangeMoi123!"
